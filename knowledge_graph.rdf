    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-003</dg:canonicalUrl>
    <dg:summary>Adopting Hatchet durable workflows backed by PostgreSQL eliminates bespoke scheduler crashes during worker node eviction.</dg:summary>
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ1" />
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ4" />
