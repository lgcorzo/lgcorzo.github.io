  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-005">
    <rdf:type rdf:resource="https://lgcorzo.github.io/ontology/dark-gravity#Experiment" />
    <dg:nodeId>EXP-2026-005</dg:nodeId>
    <rdfs:label>Asymmetric Secret Governance: SealedSecrets Key Rotation &amp; DR</rdfs:label>
    <dg:verificationStatus>verified</dg:verificationStatus>
    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-005</dg:canonicalUrl>
    <dg:summary>Strict-scoped Bitnami SealedSecrets allow safe public/private GitOps declarative secrets without storing private decryption keys in Git.</dg:summary>
