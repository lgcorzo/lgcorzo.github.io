  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-001">
    <rdf:type rdf:resource="https://lgcorzo.github.io/ontology/dark-gravity#Experiment" />
    <dg:nodeId>EXP-2026-001</dg:nodeId>
    <rdfs:label>FluxCD CI Pipeline: Kubeconform Validation False Positives</rdfs:label>
    <dg:verificationStatus>verified</dg:verificationStatus>
    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-001</dg:canonicalUrl>
    <dg:summary>Filtering raw Helm values and unrendered templates eliminates false-positive schema validation failures in GitOps CI while keeping rendered manifests strictly validated.</dg:summary>
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
  </rdf:Description>
  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-002">
    <rdf:type rdf:resource="https://lgcorzo.github.io/ontology/dark-gravity#Experiment" />
    <dg:nodeId>EXP-2026-002</dg:nodeId>
    <rdfs:label>Cargo Audit Gates vs. Unmaintained Transitive Crates</rdfs:label>
    <dg:verificationStatus>verified</dg:verificationStatus>
    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-002</dg:canonicalUrl>
    <dg:summary>Explicit risk-acceptance registries (`.cargo/audit.toml`) prevent unexploitable transitive Rust advisories from halting delivery without disabling CVE gates.</dg:summary>
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ4" />
    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ4" />
  </rdf:Description>
  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-003">
