  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-007">
    <rdf:type rdf:resource="https://lgcorzo.github.io/ontology/dark-gravity#Experiment" />
    <dg:nodeId>EXP-2026-007</dg:nodeId>
    <rdfs:label>Zero-Trust Execution Boundary: Syscall Filtering &amp; Calico Egress Blocking</rdfs:label>
    <dg:verificationStatus>verified</dg:verificationStatus>
    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-007</dg:canonicalUrl>
    <dg:summary>Combining gVisor user-space syscall interception with default-deny NetworkPolicies blocks raw sockets and unauthorized exfiltration attempts.</dg:summary>
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
