    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ4" />
  </rdf:Description>
  <rdf:Description rdf:about="https://lgcorzo.github.io/kg/EXP-2026-004">
    <rdf:type rdf:resource="https://lgcorzo.github.io/ontology/dark-gravity#Experiment" />
    <dg:nodeId>EXP-2026-004</dg:nodeId>
    <rdfs:label>Kubernetes Control Plane &amp; Worker Node Hardening</rdfs:label>
    <dg:verificationStatus>verified</dg:verificationStatus>
    <dg:canonicalUrl>https://lgcorzo.github.io/notebooks.html#exp-2026-004</dg:canonicalUrl>
    <dg:summary>Systematic CIS Kubernetes benchmark auditing eliminates privileged service accounts and enforces least-privilege RBAC across namespaces.</dg:summary>
    <dg:MEASURES rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
    <dg:VALIDATES_HYPOTHESIS rdf:resource="https://lgcorzo.github.io/kg/RQ3" />
