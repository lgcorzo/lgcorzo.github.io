    <node id="EXP-2026-001">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">FluxCD CI Pipeline: Kubeconform Validation False Positives</data>
      <data key="d_summary">Filtering raw Helm values and unrendered templates eliminates false-positive schema validation failures in GitOps CI while keeping rendered manifests strictly validated.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-001</data>
      <data key="d_properties_json">{"date": "2026-09-18", "key_metrics": {"false_positive_ci_blocks": 0, "rendered_kustomize_validation": "passed"}, "outcome": "passed", "related_rqs": ["RQ3"]}</data>
    </node>
    <node id="EXP-2026-002">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Cargo Audit Gates vs. Unmaintained Transitive Crates</data>
      <data key="d_summary">Explicit risk-acceptance registries (`.cargo/audit.toml`) prevent unexploitable transitive Rust advisories from halting delivery without disabling CVE gates.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-002</data>
      <data key="d_properties_json">{"date": "2026-10-13", "key_metrics": {"risk_register": ".cargo/audit.toml", "unexploitable_gate_bypass": false}, "outcome": "passed", "related_rqs": ["RQ3", "RQ4"]}</data>
    </node>
    <node id="EXP-2026-003">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Durable Orchestration: Hatchet DAGs vs. In-House Actor State Machines</data>
      <data key="d_summary">Adopting Hatchet durable workflows backed by PostgreSQL eliminates bespoke scheduler crashes during worker node eviction.</data>
      <data key="d_verification_status">implemented</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-003</data>
      <data key="d_properties_json">{"date": "2026-10-01", "key_metrics": {"orchestrator": "Hatchet + CloudNativePG", "status": "implemented_production"}, "outcome": "baseline", "related_rqs": ["RQ1", "RQ4"]}</data>
    </node>
    <node id="EXP-2026-004">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Kubernetes Control Plane &amp; Worker Node Hardening</data>
      <data key="d_summary">Systematic CIS Kubernetes benchmark auditing eliminates privileged service accounts and enforces least-privilege RBAC across namespaces.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-004</data>
      <data key="d_properties_json">{"date": "2026-05-14", "key_metrics": {"audit_scope": "control-plane + worker-nodes", "privileged_sa_eliminated": true}, "outcome": "passed", "related_rqs": ["RQ3"]}</data>
    </node>
    <node id="EXP-2026-005">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Asymmetric Secret Governance: SealedSecrets Key Rotation &amp; DR</data>
      <data key="d_summary">Strict-scoped Bitnami SealedSecrets allow safe public/private GitOps declarative secrets without storing private decryption keys in Git.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-005</data>
      <data key="d_properties_json">{"date": "2026-06-22", "key_metrics": {"git_plaintext_secrets": 0, "scope": "strict"}, "outcome": "passed", "related_rqs": ["RQ2", "RQ3"]}</data>
    </node>
    <node id="EXP-2026-006">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Durable Execution &amp; Idempotency Under Node Termination</data>
      <data key="d_summary">Hatchet step checkpointing resumes killed workflows automatically without corrupting repository state.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-006</data>
      <data key="d_properties_json">{"date": "2026-07-09", "key_metrics": {"resume_latency_seconds": 8.4, "state_corruption": false}, "outcome": "passed", "related_rqs": ["RQ1", "RQ3"]}</data>
    </node>
    <node id="EXP-2026-007">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Zero-Trust Execution Boundary: Syscall Filtering &amp; Calico Egress Blocking</data>
      <data key="d_summary">Combining gVisor user-space syscall interception with default-deny NetworkPolicies blocks raw sockets and unauthorized exfiltration attempts.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-007</data>
      <data key="d_properties_json">{"date": "2026-08-11", "key_metrics": {"egress_exfiltration_blocked": true, "raw_socket_blocked": true}, "outcome": "passed", "related_rqs": ["RQ3"]}</data>
    </node>
    <node id="EXP-2026-008">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Verification Triad: Deterministic Pytest Suites vs. LLM-as-a-Judge</data>
      <data key="d_summary">Relying solely on LLM judges misses subtle logic defects, whereas mandatory deterministic test execution eliminates silent logic regressions.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-008</data>
      <data key="d_properties_json">{"date": "2026-08-29", "key_metrics": {"deterministic_suite_required": true, "llm_judge_false_negative_rate_pct": 44.0}, "outcome": "passed", "related_rqs": ["RQ4"]}</data>
    </node>
    <node id="EXP-2026-009">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">AST Subgraphs vs. Raw Grep</data>
      <data key="d_summary">2-hop Tree-sitter AST neighborhood extraction reduces prompt context size while increasing first-pass code generation accuracy.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-009</data>
      <data key="d_properties_json">{"date": "2026-09-04", "key_metrics": {"first_pass_accuracy_pct": 94.0, "token_reduction_pct": 91.8}, "outcome": "passed", "related_rqs": ["RQ4"]}</data>
    </node>
    <node id="EXP-2026-010">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Predictable Cloud-Native Execution: Strict 512Mi Memory Clamping</data>
      <data key="d_summary">Explicit cgroup memory limits (`512Mi` compilation profile, `30Mi` micro-sandbox) prevent noisy-neighbor OOM exhaustion on host nodes.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-010</data>
      <data key="d_properties_json">{"date": "2026-09-27", "key_metrics": {"compilation_ram_limit": "512Mi", "host_oom_incidents": 0, "micro_sandbox_ram_limit": "30Mi"}, "outcome": "passed", "related_rqs": ["RQ3", "RQ4"]}</data>
    </node>
    <node id="EXP-2026-011">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Autonomous Security Remediation at Scale</data>
      <data key="d_summary">Separating meta-orchestration, credentialed factory controls, and surgical code-fix loops enables automated CVE remediation with sharp LLM token savings across the historical 69-repo portfolio (`64` public = `22` original + `42` maintained forks, plus `5` private/archived). A...</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-011</data>
      <data key="d_properties_json">{"date": "2026-10-20", "key_metrics": {"historical_repos_audited": 69, "merged_remediation_prs": 10, "public_repos_total": 64, "token_savings_pct": 85.0}, "outcome": "passed", "related_rqs": ["RQ1", "RQ2", "RQ3"]}</data>
    </node>
    <node id="EXP-2026-012">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Supply Chain Upgrade Paradox Across Fleet &amp; Cluster</data>
      <data key="d_summary">Synchronized lockfile exports and hash-pinned transitives prevent secondary vulnerabilities introduced by naive package bumps while reducing active Trivy cluster findings (`429 -&gt; 396` CRITICAL, `3,660 -&gt; 2,973` HIGH, `720` fixed).</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-012</data>
      <data key="d_properties_json">{"date": "2026-10-25", "key_metrics": {"trivy_critical_after": 396, "trivy_critical_before": 429, "trivy_high_after": 2973, "trivy_high_before": 3660, "vulnerabilities_fixed": 720}, "outcome": "passed", "related_rqs": ["RQ1", "RQ3"]}</data>
    </node>
    <node id="EXP-2026-013">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">End-to-End Autonomous Mission &amp; Hatchet-Orchestrated R2R GraphRAG (`Mission #476`)</data>
      <data key="d_summary">Post-merge-only R2R v3 GraphRAG ingestion orchestrated via Hatchet produces zero duplicate ingestions, reliable Leiden community graphs, and grounded MCP retrieval.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-013</data>
      <data key="d_properties_json">{"date": "2026-11-26", "key_metrics": {"cycle_time_seconds": 177, "hatchet_r2r_tasks_completed": 87, "hatchet_r2r_tasks_failed": 0, "mission_id": 476, "mlops_communities": 17, "mlops_entities": 180, "mlops_relationships": 232, "pr_number": 477}, "outcome": "passed", "related_rqs": ["RQ1", "RQ2", "RQ4"]}</data>
    </node>
    <node id="EXP-2026-014">
      <data key="d_entity_type">Experiment</data>
      <data key="d_label">Parallel Autonomous Swarm Mode &amp; Contention-Free R2R GraphRAG (`Mission #478`)</data>
      <data key="d_summary">Parallel `[P]` execution across isolated gVisor lanes with `fan-in-synthesize` and read/write-split `r2r-reader` RO replicas increases throughput without Postgres/pgvector lock contention.</data>
      <data key="d_verification_status">verified</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/notebooks.html#exp-2026-014</data>
      <data key="d_properties_json">{"date": "2026-11-26", "key_metrics": {"mission_id": 478, "mlops_collection_docs": 5, "peak_parallel_lanes": 3, "pr_number": 479, "r2r_reader_replicas": 3, "swarm_mode": true}, "outcome": "passed", "related_rqs": ["RQ1", "RQ4"]}</data>
    </node>
    <node id="RQ1">
      <data key="d_entity_type">ResearchHypothesis</data>
      <data key="d_label">RQ1: Can autonomous agents safely reduce Mean Time to Recovery (`MTTR`) under strict HITL gates?</data>
      <data key="d_summary">Contract-driven agent pipelines backed by durable Hatchet checkpoints, R2R GraphRAG context, and Review Guidance loops reduce remediation cycle time and MTTR without sacrificing CI verification or Vertex 4 human approval.</data>
      <data key="d_verification_status">experimental</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/RESEARCH.md#rq1</data>
      <data key="d_properties_json">{"evaluation_status": "partially_supported", "linked_experiments": ["EXP-2026-003", "EXP-2026-006", "EXP-2026-011", "EXP-2026-012", "EXP-2026-013", "EXP-2026-014"], "question": "Can autonomous agents safely reduce Mean Time to Recovery (`MTTR`) under strict HITL gates?", "target_metrics": ["development.mttr_hours", "development.cycle_time_hours", "security.mean_remediation_time_hours", "agents.agent_success_rate_pct"]}</data>
    </node>
    <node id="RQ2">
      <data key="d_entity_type">ResearchHypothesis</data>
      <data key="d_label">RQ2: Can cryptographic Non-Human Identities (NHI) and Verifiable Credentials improve governance and traceability?</data>
      <data key="d_summary">Binding agent missions to Ed25519 W3C Verifiable Credentials (`Ed25519Signature2020`), 300 s Vault JIT tokens (`54.2 ns` `ZeroizeOnDrop`), LiteLLM `X-Vtag-*` FinOps headers, and causal Semantica lineage yields tamper-evident attribution across multi-repo PRs.</data>
      <data key="d_verification_status">experimental</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/RESEARCH.md#rq2</data>
      <data key="d_properties_json">{"evaluation_status": "evidence_collecting", "linked_experiments": ["EXP-2026-005", "EXP-2026-011", "EXP-2026-013"], "question": "Can cryptographic Non-Human Identities (NHI) and Verifiable Credentials improve governance and traceability?", "target_metrics": ["agents.hitl_approval_rate_pct", "agents.agent_success_rate_pct", "development.lead_time_hours"]}</data>
    </node>
    <node id="RQ3">
      <data key="d_entity_type">ResearchHypothesis</data>
      <data key="d_label">RQ3: Can declarative GitOps, admission policies, and kernel sandboxing act as an enforceable security boundary?</data>
      <data key="d_summary">Combining FluxCD v2 declarative reconciliation, OpenZiti mTLS 1.3, default-deny NetworkPolicies, `ValidatingAdmissionPolicy` resource clamps (`&lt;= 30 Mi` / `250m` micro-sandbox, `&lt;= 512 Mi` / `500m` compilation), and `gVisor (runsc)` prevents privilege escalation and fleet reg...</data>
      <data key="d_verification_status">experimental</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/RESEARCH.md#rq3</data>
      <data key="d_properties_json">{"evaluation_status": "partially_supported", "linked_experiments": ["EXP-2026-001", "EXP-2026-002", "EXP-2026-004", "EXP-2026-005", "EXP-2026-006", "EXP-2026-007", "EXP-2026-010", "EXP-2026-011", "EXP-2026-012"], "question": "Can declarative GitOps, admission policies, and kernel sandboxing act as an enforceable security boundary?", "target_metrics": ["security.vulnerabilities_found_count", "security.vulnerabilities_fixed_count", "quality.escaped_defects_count"]}</data>
    </node>
    <node id="RQ4">
      <data key="d_entity_type">ResearchHypothesis</data>
      <data key="d_label">RQ4: Can structured, AST- and GraphRAG-grounded agentic workflows outperform ad-hoc workflows on reliability and token efficiency?</data>
      <data key="d_summary">Pairing AST neighborhood extraction (`OSR &lt; 5%`), deterministic test verification (replacing pure LLM judges), R2R Leiden GraphRAG with `r2r-reader` RO replicas, and parallel Swarm `[P]` execution yields higher first-pass accuracy and lower token overhead per merged PR.</data>
      <data key="d_verification_status">experimental</data>
      <data key="d_canonical_url">https://lgcorzo.github.io/RESEARCH.md#rq4</data>
      <data key="d_properties_json">{"evaluation_status": "partially_supported", "linked_experiments": ["EXP-2026-002", "EXP-2026-003", "EXP-2026-008", "EXP-2026-009", "EXP-2026-010", "EXP-2026-013", "EXP-2026-014"], "question": "Can structured, AST- and GraphRAG-grounded agentic workflows outperform ad-hoc workflows on reliability and token efficiency?", "target_metrics": ["agents.autonomous_completion_rate_pct", "quality.pr_acceptance_rate_pct", "quality.defect_density_per_kloc", "development.deployment_frequency_per_week"]}</data>
    </node>
