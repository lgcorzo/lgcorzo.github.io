    <node id="ADR-008">
      <data key="d_entity_type">ArchitectureDecision</data>
      <data key="d_label">ADR-008: Adoption of Google AX Declarative Patterns, CRD Scope, and SSOT Reconciliation Contract (v3.1)</data>
      <data key="d_summary">ADR-008 v3 (accepted) plus v3.1 amendment (proposed) resolving workspace↔mission cardinality, spec mutability, and the scope of the 30Mi/250m resource bound.</data>
      <data key="d_verification_status">verified</data>
